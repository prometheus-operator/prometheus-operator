route:
  receiver: "null"
  routes:
  - receiver: mynamespace/myamc/test
    matchers:
    - namespace="mynamespace"
    continue: true
receivers:
- name: "null"
- name: mynamespace/myamc/test
  pushover_configs:
  - user_key_file: /etc/pushover/user_key
    token_file: /etc/pushover/token
templates: []
