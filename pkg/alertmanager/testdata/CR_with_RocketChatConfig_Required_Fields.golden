route:
  receiver: "null"
  routes:
  - receiver: mynamespace/myamc/test
    matchers:
    - namespace="mynamespace"
    continue: true
receivers:
- name: "null"
- name: mynamespace/myamc/test
  rocketchat_configs:
  - token_id: my-token-id
    token: my-token
    short_fields: false
    link_names: false
templates: []
